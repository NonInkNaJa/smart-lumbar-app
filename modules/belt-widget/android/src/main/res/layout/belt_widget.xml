<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/belt_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/belt_widget_bg"
  android:gravity="center"
  android:orientation="vertical"
  android:padding="12dp">

  <TextView
    android:id="@+id/belt_widget_title"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/belt_widget_label"
    android:textColor="#6B7280"
    android:textSize="12sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/belt_widget_score"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="--"
    android:textColor="#111827"
    android:textSize="30sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/belt_widget_tier"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/belt_widget_open_app"
    android:textColor="#6B7280"
    android:textSize="13sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/belt_widget_status"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:text="@string/belt_widget_disconnected"
    android:textColor="#6B7280"
    android:textSize="12sp" />

  <TextView
    android:id="@+id/belt_widget_updated"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:textColor="#9CA3AF"
    android:textSize="10sp" />
</LinearLayout>

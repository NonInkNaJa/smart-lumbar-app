{
  "expo": {
    "name": "หลังเทพ",
    "slug": "smart-lumbar-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app_icon.png.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.nonink.smartlumbarapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app_icon.png.png",
        "backgroundColor": "#268784"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "peripheral",
            "central"
          ]
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#2563EB"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f99f1edc-1e8b-4a82-ab86-cba3650efed5"
      }
    },
    "updates": {
      "enabled": false
    }
  }
}